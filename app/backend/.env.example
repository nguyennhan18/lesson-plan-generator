# ==============================================================================
# LESSONAI-5512 MULTI-PROVIDER LLM CONFIGURATION (.env.example)
# ==============================================================================

# 1. Google Gemini API (Bắt buộc tối thiểu 1 key này)
# Đăng ký miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq Cloud API (Tùy chọn - Tốc độ cực nhanh trên LPU cho Slide & Chat)
# Đăng ký miễn phí tại: https://console.groq.com/
GROQ_API_KEY=

# 3. OpenRouter API (Tùy chọn - Đa dạng mô hình Qwen, DeepSeek, Claude)
# Đăng ký tại: https://openrouter.ai/
OPENROUTER_API_KEY=

# 4. Tùy chọn cấu hình hệ thống
MODEL_NAME=gemini-2.5-flash
PROJECT_NAME=LessonAI-5512

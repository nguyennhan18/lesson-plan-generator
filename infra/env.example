# ==============================================================================
# LessonAI-5512 Environment Configuration Template
# Copy this file to `app/backend/.env` and supply your API keys if using AI.
# ==============================================================================

# LLM Provider API Keys (Leave empty to run in fully offline, manual authoring mode)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Runtime Directories (Optional; defaults to app/backend/data and app/backend/output)
# LESSONAI_DATA_DIR=/absolute/path/to/app/backend/data
# LESSONAI_OUTPUT_DIR=/absolute/path/to/app/backend/output

# Logging Configuration
LESSONAI_LOG_LEVEL=INFO

# Local Origin Boundary (Optional; comma-separated list of allowed origins)
# LESSONAI_LOCAL_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

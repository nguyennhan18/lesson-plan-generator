# =========================================================
#  Git Ignore Configuration - LessonAI-5512
# =========================================================

# OS metadata
.DS_Store
._*
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/

# Node / Frontend
node_modules/
app/frontend/dist/

# Virtual environments & legacy folder
venv/
.venv/
env/
project/

# Secrets & Environment
.env
*.env
!.env.example
!infra/env.example

# Editor / IDE
*.swp
.idea/
.vscode/
*.code-workspace
~$*

# Binary documents & presentation archives (except test fixtures)
*.docx
*.pptx
*.pdf
!app/backend/tests/fixtures/*.docx
!app/backend/tests/fixtures/*.pptx

# Data directories (Root and Backend runtime corpus)
data/
app/backend/data/

# Generated runtime output files
app/backend/output/
*.log

# Python packaging and build metadata
app/backend/dist/

# Browser evidence is generated locally/CI, never shipped with the application.
app/frontend/test-results/
app/frontend/playwright-report/

# Reports: local empirical evidence is append-only; tracked remediation reports are whitelisted
reports/
!reports/remediation-implementation-2026-11-03.md
!reports/remediation-changed-files-2026-11-03.md
!reports/evidence-remediation-2026-11-04/

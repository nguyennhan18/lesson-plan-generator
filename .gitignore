# =========================================================
#  Git Ignore Configuration - LessonAI-5512
#  Repo công khai: mặc định track mọi thứ. Chỉ chặn artifact sinh ra khi chạy,
#  bí mật, cấu hình cá nhân, và nội dung riêng tư hoặc có bản quyền.
#  Lý do và danh sách: docs/adr/0012-track-mac-dinh-chan-noi-dung-rieng-tu.md
# =========================================================

# OS metadata
.DS_Store
._*
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/

# Node / Frontend
node_modules/
app/frontend/dist/
app/frontend/test-results/
app/frontend/playwright-report/

# Virtual environments & legacy folder
venv/
.venv/
env/
project/

# Bí mật và cấu hình cục bộ
.env
*.env
!.env.example
.claude/settings.local.json

# Editor / IDE (cấu hình cá nhân)
*.swp
.idea/
.vscode/
*.code-workspace
~$*

# Tài liệu Office/PDF: thường chứa nội dung SGK hoặc hồ sơ đồ án
*.docx
*.pptx
*.pdf

# Học liệu SGK gốc và corpus runtime (bản quyền)
data/raw/
data/processed/
app/backend/data/

# Hồ sơ đồ án (riêng tư)
docs/requirements/

# Output sinh ra khi chạy
app/backend/output/
app/backend/dist/
*.log

# Bằng chứng thực nghiệm: mặc định không công bố, chỉ giữ thư mục được ADR hoặc issue dẫn chiếu
reports/*
!reports/math12-benchmark-baseline-20261122-DDw4sJ/

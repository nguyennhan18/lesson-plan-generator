# =========================================================
#  Git Ignore Configuration - LessonAI-5512
# =========================================================

# OS metadata
.DS_Store
._*
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/

# Node / Frontend
node_modules/
app/frontend/dist/

# Virtual environments & legacy folder
venv/
.venv/
env/
project/

# Secrets & Environment
.env
*.env
!.env.example
!infra/env.example

# Editor / IDE
*.swp
.idea/
.vscode/
*.code-workspace
~$*

# Binary documents & presentation archives
*.docx
*.pptx
*.pdf

# Data directories (Root and Backend runtime corpus)
data/
app/backend/data/

# Generated runtime output files
app/backend/output/
*.log

# Python packaging and build metadata
app/backend/dist/

# Browser evidence & test artifacts
app/frontend/test-results/
app/frontend/playwright-report/

# Documents, Reports & Planning files (local-only, not pushed to Git)
docs/
reports/
project-management/
quality/
PROGRESS.md
DECISIONS.md
SKILL.md
.claude/

# Test suites & verification scripts (local-only, not pushed to Git)
app/backend/tests/
app/frontend/tests/
app/frontend/e2e/
scripts/

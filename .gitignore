# =========================================================
#  Git Ignore Configuration - LessonAI-5512
# =========================================================

# OS metadata
.DS_Store
._*
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/

# Node / Frontend
node_modules/
app/frontend/dist/

# Virtual environments & legacy folder
venv/
.venv/
env/
project/

# Secrets
.env
*.env
!.env.example

# Editor / IDE
*.swp
.idea/
.vscode/
~$*

# Generated output files
app/backend/output/
*.log

# Explicitly keep templates and test fixtures
!app/backend/src/templates/*.pptx
!app/backend/tests/fixtures/*.docx
!app/backend/tests/fixtures/*.pptx

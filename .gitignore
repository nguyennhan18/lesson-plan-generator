# =========================================================
#  WHITELIST MODE: bỏ qua TẤT CẢ, chỉ cho phép những gì liệt kê bên dưới
# =========================================================

# 1. Bỏ qua mọi thứ ở thư mục gốc
/*

# 2. Chỉ cho phép các file/thư mục này
!/.gitignore
!/project/

# =========================================================
#  Rác bên trong project/ (vẫn bị bỏ qua dù project/ được phép)
# =========================================================

# OS
.DS_Store
._*
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Virtual env
venv/
.venv/
env/

# Secrets
.env
*.env

# IDE
.vscode/
.idea/
*.swp

# File Office sinh ra khi test (giữ lại template)
*.pptx
*.docx
~$*
!project/app/templates/*.pptx
project/test/pptx/
project/test/word/

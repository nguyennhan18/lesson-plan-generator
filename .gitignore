# OS metadata
.DS_Store
._*
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/

# Node / Frontend
node_modules/
app/frontend/dist/

# Virtual environments & legacy folder
venv/
.venv/
env/
project/

# Secrets
.env
*.env
!.env.example

# Editor / IDE
*.swp
.idea/
.vscode/
*.code-workspace
~$*

# Documents, Reports & Planning files
docs/
reports/
plan_*.md
*.docx
*.pptx
*.pdf

# Data directories (Root and Backend)
data/
app/backend/data/

# Generated output files
app/backend/output/
*.log

# Python packaging and build metadata
app/backend/dist/
